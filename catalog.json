---
layout: null
---
{%- comment -%}
  content/_series ve content/_chapters içindeki Markdown dosyalarından seri kataloğunu üretir.
  GitHub Pages her yayında bunu otomatik derler; elle düzenlemeye gerek yok.
{%- endcomment -%}
[
{%- assign first = true -%}
{%- for s in site.series -%}
  {%- assign chs = site.chapters | where: "series", s.slug | where_exp: "c", "c.draft != true" | sort: "number" -%}
  {%- if chs.size > 0 -%}
    {%- unless first -%},{%- endunless -%}
    {%- assign first = false %}
{"id":{{ s.slug | jsonify }},"type":{{ s.type | jsonify }},"title":{{ s.title | jsonify }},"author":{{ s.author | jsonify }},"artist":{{ s.artist | jsonify }},"rating":{{ s.rating | jsonify }},"featured":{{ s.featured | jsonify }},"genres":{{ s.genres | jsonify }},"status":{{ s.status | jsonify }},"year":{{ s.year | jsonify }},"palette":[{{ s.color | jsonify }},{{ s.accent | jsonify }}],"cover":{{ s.cover | jsonify }},"banner":{{ s.banner | jsonify }},"synopsis":{{ s.synopsis | jsonify }},"chapters":[
    {%- for c in chs -%}
{"number":{{ c.number | jsonify }},"title":{{ c.title | jsonify }},"released":{% if c.released %}{{ c.released | date: "%Y-%m-%dT%H:%M:%S%:z" | jsonify }}{% else %}null{% endif %},
      {%- if s.type == "manga" -%}"images":{{ c.pages | jsonify }}{%- else -%}"html":{{ c.content | markdownify | strip | jsonify }}{%- endif -%}}
      {%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
]}
  {%- endif -%}
{%- endfor %}
]
