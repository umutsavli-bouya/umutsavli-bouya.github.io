---
layout: null
---
{%- comment -%}
  content/_blog içindeki yazılardan liste üretir. En yenisi en üstte.
{%- endcomment -%}
{%- assign items = site.blog | where_exp: "p", "p.draft != true" | sort: "date" | reverse -%}
[
{%- for p in items -%}
{%- assign html = p.content | markdownify -%}
{"slug":{{ p.slug | jsonify }},"title":{{ p.title | jsonify }},"date":{{ p.date | date: "%Y-%m-%dT%H:%M:%S%:z" | jsonify }},"author":{{ p.author | jsonify }},"excerpt":{% if p.excerpt_text %}{{ p.excerpt_text | jsonify }}{% else %}{{ html | strip_html | strip_newlines | truncate: 180 | jsonify }}{% endif %},"html":{{ html | strip | jsonify }}}
{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
